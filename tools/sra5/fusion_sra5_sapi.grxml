      </item>
      <item>déplace ce losange rouge ici<tag>out = "action=move shape=diamond color=red position_ref=true";</tag>
      </item>
      <item>déplace ce losange vert ici<tag>out = "action=move shape=diamond color=green position_ref=true";</tag>
      </item>
      <item>déplace ce losange bleu ici<tag>out = "action=move shape=diamond color=blue position_ref=true";</tag>
